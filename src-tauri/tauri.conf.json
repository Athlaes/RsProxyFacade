{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rs-proxy-facade",
  "version": "0.1.0",
  "identifier": "dev.athaes.rs-proxy-facade",
  "build": {
    "beforeDevCommand": "npm run start",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/rs-proxy-facade/browser"
  },
  "app": {
    "windows": [
      {
        "center": true,
        "resizable": false,
        "maximizable": false,
        "title": "rs-proxy-facade",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
